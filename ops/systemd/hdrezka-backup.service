[Unit]
Description=HdRezka PostgreSQL backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/opt/hdrezka_search
Environment=BACKUP_RETENTION_DAYS=14
ExecStart=/opt/hdrezka_search/scripts/backup-db.sh
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
